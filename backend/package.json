{
  "name": "saudichat-pro-backend",
  "version": "1.0.0",
  "description": "SaudiChat Pro - WhatsApp Business Automation API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npx prisma generate && npx tsc",
    "start": "node dist/index.js",
    "start:railway": "node dist/index.js",
    "start:prod": "npx prisma db push --skip-generate && node dist/index.js",
    "start:prod:full": "npx prisma generate && npx prisma db push && npx tsx prisma/seed.ts && node dist/index.js",
    "postinstall": "npx prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "seed:manpower-demo": "tsx prisma/seed-manpower-demo.ts",
    "db:studio": "prisma studio",
    "worker": "tsx src/queue/startWorker.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.78.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.73.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.21.0",
    "prisma": "^5.22.0",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.20.0"
  }
}

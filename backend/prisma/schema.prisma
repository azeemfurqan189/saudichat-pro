// ─── Project Planning (Primavera-style) ─────────────────────────────────────

model Program {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  code        String?
  description String?
  status      String   @default("ACTIVE")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  projects ScheduleProject[]

  @@index([businessId])
  @@map("programs")
}

model ScheduleProject {
  id              String    @id @default(uuid())
  businessId      String
  programId       String?
  agencyProjectId String?
  name            String
  code            String?
  plannedStart    DateTime?
  plannedFinish   DateTime?
  status          String    @default("PLANNING")
  calendarConfig  Json      @default("{}")
  penaltyPerDay   Float     @default(15000)
  shiftHours      Float     @default(8)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  program       Program?        @relation(fields: [programId], references: [id], onDelete: SetNull)
  agencyProject AgencyProject?  @relation(fields: [agencyProjectId], references: [id], onDelete: SetNull)
  wbsNodes      WbsNode[]
  activities    ScheduleActivity[]
  dependencies  ActivityDependency[]
  baselines     ScheduleBaseline[]
  changeOrders  ScheduleChangeOrder[]

  @@index([businessId])
  @@index([programId])
  @@index([agencyProjectId])
  @@map("schedule_projects")
}

model WbsNode {
  id         String   @id @default(uuid())
  businessId String
  projectId  String
  parentId   String?
  code       String
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project    ScheduleProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent     WbsNode?         @relation("WbsTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   WbsNode[]        @relation("WbsTree")
  activities ScheduleActivity[]

  @@index([businessId])
  @@index([projectId])
  @@index([parentId])
  @@map("wbs_nodes")
}

model ScheduleActivity {
  id              String    @id @default(uuid())
  businessId      String
  projectId       String
  wbsNodeId       String?
  code            String?
  name            String
  durationDays    Float     @default(1)
  plannedStart    DateTime?
  plannedFinish   DateTime?
  percentComplete Float     @default(0)
  status          String    @default("NOT_STARTED")
  isCritical      Boolean   @default(false)
  totalFloat      Float?
  earlyStart      DateTime?
  earlyFinish     DateTime?
  lateStart       DateTime?
  lateFinish      DateTime?
  laborCost          Float?
  materialCost       Float?
  workOrderId        String?   @unique
  startOverrideDays  Float?
  equipmentTag       String?
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project      ScheduleProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode      WbsNode?              @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  workOrder    WorkOrder?            @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  predecessors ActivityDependency[]  @relation("SuccActivity")
  successors   ActivityDependency[]  @relation("PredActivity")
  resources    ActivityResource[]
  materials    ActivityMaterial[]

  @@index([businessId])
  @@index([projectId])
  @@index([wbsNodeId])
  @@map("schedule_activities")
}

model ActivityDependency {
  id            String @id @default(uuid())
  businessId    String
  projectId     String
  predecessorId String
  successorId   String
  type          String @default("FS")
  lagDays       Float  @default(0)

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project     ScheduleProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessor ScheduleActivity @relation("PredActivity", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   ScheduleActivity @relation("SuccActivity", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([businessId])
  @@index([projectId])
  @@map("activity_dependencies")
}

model ActivityResource {
  id              String  @id @default(uuid())
  businessId      String
  activityId      String
  workerProfileId String?
  tradeRole       String?
  units           Float   @default(1)
  hours           Float?

  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  activity      ScheduleActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  workerProfile WorkerProfile?   @relation(fields: [workerProfileId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([activityId])
  @@map("activity_resources")
}

model ActivityMaterial {
  id          String  @id @default(uuid())
  businessId  String
  activityId  String
  sparePartId String?
  description String?
  plannedQty  Float   @default(1)
  unitCost    Float?

  business  Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  activity  ScheduleActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  sparePart SparePart?       @relation(fields: [sparePartId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([activityId])
  @@map("activity_materials")
}

model ScheduleBaseline {
  id         String   @id @default(uuid())
  businessId String
  projectId  String
  name       String   @default("Baseline 1")
  snapshot   Json     @default("{}")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project  ScheduleProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([projectId])
  @@map("schedule_baselines")
}

model ScheduleChangeOrder {
  id                  String    @id @default(uuid())
  businessId          String
  projectId           String
  number              String
  title               String
  description         String?
  scopeChange         String?
  costImpactSar       Float     @default(0)
  scheduleImpactDays  Float     @default(0)
  status              String    @default("DRAFT")
  affectsBaseline     Boolean   @default(true)
  requestedByMemberId String?
  approvedByMemberId  String?
  approvedAt          DateTime?
  rejectionReason     String?
  changeLog           Json      @default("[]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project  ScheduleProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([projectId])
  @@index([status])
  @@map("schedule_change_orders")
}

model WorkerProfile {
  id             String    @id @default(uuid())
  businessId     String
  memberId       String?
  name           String
  phone          String?
  nationality    String?
  iqamaNumber    String?
  iqamaExpiry    DateTime?
  category       String?
  loginPassword  String?
  attendanceQrToken String? @unique
  defaultHours   Float?    @default(8)
  skills         Json      @default("[]")
  hourlyRate     Float?
  contractType   String?
  status         String    @default("AVAILABLE")
  notes          String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  placements Placement[]
  timesheets Timesheet[]
  dailyAttendance WorkerDailyAttendance[]
  equipmentAssignments AgencyEquipment[]
  certifications WorkerCertification[]
  trainingRecords WorkerTraining[]
  activityResources ActivityResource[]
  leaveBalances   WorkerLeaveBalance[]
  leaveRequests   WorkerLeaveRequest[]
  competencies    WorkerCompetency[]
  successionsAsKey WorkerSuccession[] @relation("SuccessionKeyWorker")
  successionsAsBackup WorkerSuccession[] @relation("SuccessionBackupWorker")

  @@index([businessId])
  @@index([status])
  @@index([memberId])
}

model Placement {
  id              String    @id @default(uuid())
  businessId      String
  workerProfileId String
  clientCompanyId String
  projectId       String?
  siteName        String?
  startDate       DateTime
  endDate         DateTime?
  status          String    @default("ACTIVE")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workerProfile WorkerProfile  @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  clientCompany ClientCompany  @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)
  project       AgencyProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  timesheets    Timesheet[]

  @@index([businessId])
  @@index([workerProfileId])
  @@index([clientCompanyId])
  @@index([projectId])
}

model Timesheet {
  id              String   @id @default(uuid())
  businessId      String
  workerProfileId String
  clientCompanyId String?
  projectId       String?
  placementId     String?
  workDate        DateTime
  regularHours    Float?
  overtimeHours   Float?
  hoursWorked     Float
  status          String   @default("PENDING")
  rejectReason    String?
  submittedByMemberId String?
  approvedByMemberId  String?
  rejectedByMemberId  String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  lastReminderAt  DateTime?
  overtimePay     Float?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workerProfile WorkerProfile  @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  clientCompany ClientCompany? @relation(fields: [clientCompanyId], references: [id], onDelete: SetNull)
  project       AgencyProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  placement     Placement?     @relation(fields: [placementId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([workerProfileId])
  @@index([projectId])
  @@index([workDate])
  @@index([status])
}

model WorkerDailyAttendance {
  id              String   @id @default(uuid())
  businessId      String
  workerProfileId String
  projectId       String?
  workDate        DateTime
  status          String   @default("PRESENT")
  checkInMethod   String?  @default("MANUAL")
  checkInLat      Float?
  checkInLng      Float?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workerProfile WorkerProfile  @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  project       AgencyProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([workerProfileId, projectId, workDate])
  @@index([businessId])
  @@index([projectId])
  @@index([workDate])
}

model ProjectMemberAccess {
  id          String   @id @default(uuid())
  businessId  String
  projectId   String
  memberId    String
  permissions Json     @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project  AgencyProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member   BusinessMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@index([businessId])
  @@index([memberId])
  @@index([projectId])
}

// ─── CMMS Advanced (BOM, meters, calibration) ───────────────────────────────

model AssetComponent {
  id                String   @id @default(uuid())
  businessId        String
  equipmentId       String
  parentComponentId String?
  name              String
  partNumber        String?
  sparePartId       String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  equipment       AgencyEquipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  parentComponent AssetComponent?  @relation("ComponentTree", fields: [parentComponentId], references: [id], onDelete: Cascade)
  childComponents AssetComponent[] @relation("ComponentTree")
  sparePart       SparePart?       @relation(fields: [sparePartId], references: [id], onDelete: SetNull)
  bomItems        AssetBomItem[]

  @@index([businessId])
  @@index([equipmentId])
  @@index([parentComponentId])
  @@map("asset_components")
}

model AssetBomItem {
  id          String @id @default(uuid())
  businessId  String
  equipmentId String
  componentId String?
  sparePartId String
  qty         Float  @default(1)
  notes       String?

  business  Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  equipment AgencyEquipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  component AssetComponent?  @relation(fields: [componentId], references: [id], onDelete: Cascade)
  sparePart SparePart        @relation(fields: [sparePartId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([equipmentId])
  @@index([componentId])
  @@map("asset_bom_items")
}

model EquipmentMeterReading {
  id          String   @id @default(uuid())
  businessId  String
  equipmentId String
  readingType String   @default("HOURS")
  value       Float
  recordedAt  DateTime @default(now())
  source      String   @default("MANUAL")
  notes       String?

  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  equipment AgencyEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([equipmentId])
  @@index([recordedAt])
  @@map("equipment_meter_readings")
}

model CalibrationRecord {
  id               String    @id @default(uuid())
  businessId       String
  equipmentId      String?
  instrumentName   String
  lastCalibratedAt DateTime?
  nextDueAt        DateTime?
  certNumber       String?
  status           String    @default("VALID")
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business  Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  equipment AgencyEquipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([equipmentId])
  @@index([nextDueAt])
  @@index([status])
  @@map("calibration_records")
}

// ─── Project Finance Advanced ───────────────────────────────────────────────

model ProjectFinancialEntry {
  id                String   @id @default(uuid())
  businessId        String
  agencyProjectId   String?
  scheduleProjectId String?
  category          String
  amountSar         Float
  reference         String?
  description       String?
  recordedAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  agencyProject AgencyProject? @relation(fields: [agencyProjectId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([agencyProjectId])
  @@index([category])
  @@map("project_financial_entries")
}

model ProjectMilestone {
  id               String    @id @default(uuid())
  businessId       String
  agencyProjectId  String
  name             String
  triggerPercent   Float     @default(50)
  invoiceAmountSar Float
  retentionPct     Float     @default(10)
  status           String    @default("PENDING")
  invoicedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  agencyProject AgencyProject @relation(fields: [agencyProjectId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([agencyProjectId])
  @@index([status])
  @@map("project_milestones")
}

model Subcontractor {
  id           String   @id @default(uuid())
  businessId   String
  name         String
  trade        String?
  contactEmail String?
  contactPhone String?
  status       String   @default("ACTIVE")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business   Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pos        SubcontractorPurchaseOrder[]
  timesheets SubcontractorTimesheet[]
  invoices   SubcontractorInvoice[]

  @@index([businessId])
  @@index([status])
  @@map("subcontractors")
}

model SubcontractorPurchaseOrder {
  id              String   @id @default(uuid())
  businessId      String
  subcontractorId String
  projectId       String?
  number          String
  amountSar       Float
  status          String   @default("ISSUED")
  description     String?
  issuedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor  @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  project       AgencyProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([businessId, number])
  @@index([businessId])
  @@index([subcontractorId])
  @@map("subcontractor_pos")
}

model SubcontractorTimesheet {
  id              String   @id @default(uuid())
  businessId      String
  subcontractorId String
  projectId       String?
  workDate        DateTime
  hours           Float
  amountSar       Float?
  status          String   @default("PENDING")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor  @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  project       AgencyProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([subcontractorId])
  @@index([workDate])
  @@map("subcontractor_timesheets")
}

model SubcontractorInvoice {
  id              String    @id @default(uuid())
  businessId      String
  subcontractorId String
  number          String
  amountSar       Float
  status          String    @default("PENDING")
  dueAt           DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)

  @@unique([businessId, number])
  @@index([businessId])
  @@index([subcontractorId])
  @@map("subcontractor_invoices")
}

// ─── HR Advanced (leave, competency, succession) ────────────────────────────

model WorkerLeaveBalance {
  id              String @id @default(uuid())
  businessId      String
  workerProfileId String
  leaveType       String @default("ANNUAL")
  balanceDays     Float  @default(30)
  usedDays        Float  @default(0)

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@unique([workerProfileId, leaveType])
  @@index([businessId])
  @@map("worker_leave_balances")
}

model WorkerLeaveRequest {
  id              String   @id @default(uuid())
  businessId      String
  workerProfileId String
  leaveType       String   @default("ANNUAL")
  startDate       DateTime
  endDate         DateTime
  days            Float
  status          String   @default("PENDING")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([workerProfileId])
  @@index([status])
  @@map("worker_leave_requests")
}

model WorkerCompetency {
  id              String    @id @default(uuid())
  businessId      String
  workerProfileId String
  skill           String
  grade           String    @default("B")
  ratedByMemberId String?
  ratedAt         DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@unique([workerProfileId, skill])
  @@index([businessId])
  @@map("worker_competencies")
}

model WorkerSuccession {
  id                    String   @id @default(uuid())
  businessId            String
  workerProfileId       String
  replacementWorkerId   String
  role                  String?
  priority              Int      @default(1)
  status                String   @default("APPROVED")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business            Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  keyWorker           WorkerProfile @relation("SuccessionKeyWorker", fields: [workerProfileId], references: [id], onDelete: Cascade)
  replacementWorker   WorkerProfile @relation("SuccessionBackupWorker", fields: [replacementWorkerId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([workerProfileId])
  @@map("worker_successions")
}

// Prevents duplicate WhatsApp replies when Whapi hits multiple webhook URLs or retries.
model InboundMessageDedup {
  id         String   @id @default(uuid())
  businessId String
  externalId String
  createdAt  DateTime @default(now())

  @@unique([businessId, externalId])
  @@index([businessId, createdAt])
}

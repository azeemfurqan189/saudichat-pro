DATABASE_URL="postgresql://postgres:password@localhost:5432/saudichat_pro?schema=public"
# Neon/Supabase: use NON-POOLER URL here for prisma db push (Railway variable)
DIRECT_URL="postgresql://postgres:password@localhost:5432/saudichat_pro?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
# Public HTTPS URL for menu PDFs (WhatsApp document links). On Railway use your service URL.
PUBLIC_API_URL="https://your-backend.up.railway.app"
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
OPENAI_API_KEY=""
# Groq (fast/cheap) — https://console.groq.com → API Keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# auto | groq | openai — auto uses Groq if GROQ_API_KEY is set, else OpenAI
AI_PROVIDER="auto"
OPENAI_MODEL="gpt-4o-mini"
WHATSAPP_VERIFY_TOKEN="saudichat_verify_token"
WHATSAPP_API_VERSION="v25.0"
# Meta webhook signature verification (optional in dev — skips if unset)
WHATSAPP_APP_SECRET=""
# Whapi webhook secret (optional in dev — skips if unset)
WHAPI_WEBHOOK_SECRET=""
# meta | whapi — default provider; override per business in settings.whatsappProvider
WHATSAPP_PROVIDER="whapi"
# Set EMBED_WORKER=false to run worker as separate process (npm run worker)
EMBED_WORKER="true"
# Whapi processes messages synchronously by default (fast replies). Set true to use BullMQ queue.
WHAPI_USE_QUEUE="false"
WORKER_CONCURRENCY="5"
